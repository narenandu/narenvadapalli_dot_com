---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');

// Sort posts by date (descending)
const sortedPosts = posts.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

// Clean slug helper and strip 4-digit prefix
const cleanSlug = (id: string) => id.replace('/index.md', '').replace('index.md', '').trim().replace(/^\d{4}-/, '');

// Extract unique years and months from posts dynamically
const archiveDates = sortedPosts.reduce((acc, post) => {
  if (post.data.date) {
    const date = new Date(post.data.date);
    const year = date.getUTCFullYear();
    const month = date.getUTCMonth(); // 0-11
    if (!acc[year]) {
      acc[year] = new Set<number>();
    }
    acc[year].add(month);
  }
  return acc;
}, {} as Record<number, Set<number>>);

// Convert sets to sorted arrays
const archiveList = Object.keys(archiveDates)
  .map(Number)
  .sort((a, b) => b - a)
  .map(year => ({
    year,
    months: Array.from(archiveDates[year]).sort((a, b) => a - b) // 0-indexed months
  }));

// Get unique tags across all posts dynamically
const allTags = Array.from(
  new Set(sortedPosts.flatMap(post => post.data.tags || []))
).sort();
---

<Layout 
  title="Blog | Naren Vadapalli" 
  description="Personal blog of Naren Vadapalli covering DevOps, Software Engineering, Python, VFX, and Automation"
>
  <div class="blog-index-page">
    <div class="page-header">
      <div class="container">
        <h1>My Blog</h1>
        <p class="subtitle">Reflections on software engineering, pipeline automation, graphics, and system reliability.</p>
      </div>
    </div>

    <div class="container blog-list-container">
      <!-- Hidden element storing dynamic archive schema for client script -->
      <div id="archiveData" data-archive={JSON.stringify(archiveList)} style="display: none;"></div>

      <!-- Snug Centered Calendar Filter Panel -->
      <div class="calendar-filter-wrapper">
        <div class="calendar-filter-container">
          <span class="calendar-label">Filter by Date:</span>
          <div class="date-selectors">
            <div class="select-wrapper">
              <select id="yearFilter" class="filter-select" aria-label="Filter by Year">
                <option value="all">All Years</option>
                {archiveList.map(({ year }) => (
                  <option value={year}>{year}</option>
                ))}
              </select>
            </div>
            
            <div class="select-wrapper">
              <select id="monthFilter" class="filter-select" disabled aria-label="Filter by Month">
                <option value="all">All Months</option>
                <option value="0">January</option>
                <option value="1">February</option>
                <option value="2">March</option>
                <option value="3">April</option>
                <option value="4">May</option>
                <option value="5">June</option>
                <option value="6">July</option>
                <option value="7">August</option>
                <option value="8">September</option>
                <option value="9">October</option>
                <option value="10">November</option>
                <option value="11">December</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="filter-status" id="filterStatus" style="display: none;">
        <span class="filter-text">Active Filters:</span>
        <div id="activeFiltersList" class="active-filters-list"></div>
        <button type="button" id="clearFilterBtn" class="clear-all-btn">Clear All</button>
      </div>

      <!-- Top Pagination Controls -->
      <div class="pagination-container pagination-top" id="paginationContainerTop" style="display: none;">
        <button type="button" id="prevPageBtnTop" class="pagination-btn" aria-label="Previous Page">&larr; Previous</button>
        <div id="pageNumbersContainerTop" class="page-numbers"></div>
        <button type="button" id="nextPageBtnTop" class="pagination-btn" aria-label="Next Page">Next &rarr;</button>
      </div>

      <div class="blog-grid">
        {sortedPosts.map(post => {
          const dateString = post.data.date 
            ? post.data.date.toLocaleDateString('en-US', {
                timeZone: 'UTC',
                year: 'numeric',
                month: 'short',
                day: 'numeric'
              })
            : '';
            
          const slug = cleanSlug(post.id);
          const tagsList = post.data.tags ? post.data.tags.join(',') : 'tech';
          
          return (
            <article class="card blog-list-card" data-tags={tagsList} data-date={post.data.date ? post.data.date.toISOString() : ''}>
              {post.data.image && (
                <div class="card-thumbnail">
                  <a href={`/blog/${slug}`}>
                    {typeof post.data.image === 'object' ? (
                      <Image 
                        src={post.data.image} 
                        alt={post.data.title}
                        class="thumbnail-img"
                      />
                    ) : (
                      <img 
                        src={post.data.image} 
                        alt={post.data.title}
                        class="thumbnail-img"
                      />
                    )}
                  </a>
                </div>
              )}
              <div class="card-content">
                <div class="card-meta">
                  <span class="card-date">{dateString}</span>
                  <div class="card-badges">
                    {post.data.tags && post.data.tags.map(tag => (
                      <button type="button" class="card-badge tag-button" data-tag={tag}>{tag}</button>
                    ))}
                    {(!post.data.tags || post.data.tags.length === 0) && (
                      <button type="button" class="card-badge tag-button" data-tag="tech">Tech</button>
                    )}
                  </div>
                </div>
                <h2>
                  <a href={`/blog/${slug}`}>{post.data.title}</a>
                </h2>
                {post.data.description && <p class="card-description">{post.data.description}</p>}
                <div class="card-footer">
                  <a href={`/blog/${slug}`} class="read-more">
                    Read Article &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Pagination controls -->
      <div class="pagination-container" id="paginationContainer" style="display: none;">
        <button type="button" id="prevPageBtn" class="pagination-btn prev-btn" aria-label="Previous page">&larr; Previous</button>
        <div id="pageNumbersContainer" class="page-numbers"></div>
        <button type="button" id="nextPageBtn" class="pagination-btn next-btn" aria-label="Next page">Next &rarr;</button>
      </div>
      
      <!-- Google AdSense Manual Ad Unit -->
      {import.meta.env.PROD && (
        <div class="ad-container" style="margin-top: 2.5rem; min-height: 90px; text-align: center; border-top: 1px solid var(--border-color); padding-top: 2rem;">
          <ins class="adsbygoogle"
               style="display:block"
               data-ad-client="ca-pub-1520134626921920"
               data-ad-slot="4095570942"
               data-ad-format="auto"
               data-full-width-responsive="true"></ins>
          <script is:inline>
               (adsbygoogle = window.adsbygoogle || []).push({});
          </script>
        </div>
      )}
      <!-- Client-side Tag Filtering, Calendar Filtering & Pagination -->
      <script is:inline>
        (function() {
          var ITEMS_PER_PAGE = 10;
          var currentPage = 1;
          var activeTag = null;
          var activeYear = null;
          var activeMonth = null;

          var MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

          function getCards() {
            return Array.from(document.querySelectorAll('.blog-list-card'));
          }

          function getMatchingCards() {
            var allCards = getCards();
            return allCards.filter(function(card) {
              if (activeTag) {
                var tagsAttr = card.getAttribute('data-tags');
                var tags = tagsAttr ? tagsAttr.split(',').map(function(t) { return t.trim().toLowerCase(); }) : [];
                if (!tags.includes(activeTag.toLowerCase())) {
                  return false;
                }
              }

              if (activeYear) {
                var dateAttr = card.getAttribute('data-date');
                if (dateAttr) {
                  var date = new Date(dateAttr);
                  var year = date.getUTCFullYear();
                  if (year !== parseInt(activeYear, 10)) {
                    return false;
                  }
                  
                  if (activeMonth !== null) {
                    var month = date.getUTCMonth();
                    if (month !== parseInt(activeMonth, 10)) {
                      return false;
                    }
                  }
                } else {
                  return false;
                }
              }

              return true;
            });
          }

          function updateView() {
            var allCards = getCards();
            var matchingCards = getMatchingCards();
            var totalPages = Math.ceil(matchingCards.length / ITEMS_PER_PAGE) || 1;
            
            if (currentPage < 1) currentPage = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            // Hide all cards first
            allCards.forEach(function(card) {
              card.style.display = 'none';
              card.classList.add('hidden-card');
            });

            // Show only matching cards for current page
            var startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
            var endIndex = currentPage * ITEMS_PER_PAGE;

            matchingCards.forEach(function(card, index) {
              if (index >= startIndex && index < endIndex) {
                if (card.style.display !== 'flex') card.style.display = 'flex';
                card.classList.remove('hidden-card');
              } else {
                if (card.style.display !== 'none') card.style.display = 'none';
                card.classList.add('hidden-card');
              }
            });

            var yearFilter = document.getElementById('yearFilter');
            var monthFilter = document.getElementById('monthFilter');
            var filterStatus = document.getElementById('filterStatus');
            var activeFiltersList = document.getElementById('activeFiltersList');
            var paginationContainer = document.getElementById('paginationContainer');
            var pageNumbersContainer = document.getElementById('pageNumbersContainer');
            var prevPageBtn = document.getElementById('prevPageBtn');
            var nextPageBtn = document.getElementById('nextPageBtn');
            var paginationContainerTop = document.getElementById('paginationContainerTop');
            var pageNumbersContainerTop = document.getElementById('pageNumbersContainerTop');
            var prevPageBtnTop = document.getElementById('prevPageBtnTop');
            var nextPageBtnTop = document.getElementById('nextPageBtnTop');

            // Update Date selects
            if (yearFilter) {
              yearFilter.value = activeYear || 'all';
            }
            
            if (monthFilter) {
              if (activeYear) {
                monthFilter.disabled = false;
                monthFilter.value = activeMonth !== null ? activeMonth.toString() : 'all';
                
                var archiveDataEl = document.getElementById('archiveData');
                var archiveList = archiveDataEl ? JSON.parse(archiveDataEl.getAttribute('data-archive') || '[]') : [];
                var selectedYearData = archiveList.find(function(item) { return item.year === parseInt(activeYear, 10); });
                var validMonths = selectedYearData ? selectedYearData.months : [];
                
                Array.from(monthFilter.options).forEach(function(opt) {
                  if (opt.value === 'all') return;
                  var monthNum = parseInt(opt.value, 10);
                  if (validMonths.includes(monthNum)) {
                    opt.disabled = false;
                    opt.style.display = 'block';
                  } else {
                    opt.disabled = true;
                    opt.style.display = 'none';
                  }
                });
              } else {
                monthFilter.disabled = true;
                monthFilter.value = 'all';
              }
            }

            // Update Active Filters List
            if (activeFiltersList) {
              activeFiltersList.innerHTML = '';
              
              if (activeTag) {
                var tagPill = document.createElement('span');
                tagPill.className = 'filter-pill';
                var countText = matchingCards.length === 1 ? '1 post' : matchingCards.length + ' posts';
                tagPill.innerHTML = 'Tag: #' + activeTag + ' (' + countText + ') <button type="button" class="pill-clear-btn" data-type="tag" aria-label="Clear tag filter">&times;</button>';
                activeFiltersList.appendChild(tagPill);
              }
              
              if (activeYear) {
                var datePill = document.createElement('span');
                datePill.className = 'filter-pill';
                var dateDesc = activeMonth !== null ? MONTH_NAMES[activeMonth] + ' ' + activeYear : activeYear;
                var dateCountText = matchingCards.length === 1 ? '1 post' : matchingCards.length + ' posts';
                datePill.innerHTML = 'Date: ' + dateDesc + ' (' + dateCountText + ') <button type="button" class="pill-clear-btn" data-type="date" aria-label="Clear date filter">&times;</button>';
                activeFiltersList.appendChild(datePill);
              }
            }

            if (activeTag || activeYear || activeMonth !== null) {
              if (filterStatus) filterStatus.style.display = 'flex';
            } else {
              if (filterStatus) filterStatus.style.display = 'none';
            }

            // Update Tag buttons glow
            var allTagButtons = document.querySelectorAll('.tag-button');
            allTagButtons.forEach(function(btn) {
              var tag = btn.getAttribute('data-tag');
              if (activeTag && tag && tag.toLowerCase() === activeTag.toLowerCase()) {
                btn.classList.add('active-tag');
              } else {
                btn.classList.remove('active-tag');
              }
            });

            // Update Pagination controls
            if (totalPages <= 1) {
              if (paginationContainer) paginationContainer.style.display = 'none';
              if (paginationContainerTop) paginationContainerTop.style.display = 'none';
            } else {
              if (paginationContainer) paginationContainer.style.display = 'flex';
              if (paginationContainerTop) paginationContainerTop.style.display = 'flex';
              
              if (prevPageBtn) prevPageBtn.disabled = currentPage === 1;
              if (prevPageBtnTop) prevPageBtnTop.disabled = currentPage === 1;
              if (nextPageBtn) nextPageBtn.disabled = currentPage === totalPages;
              if (nextPageBtnTop) nextPageBtnTop.disabled = currentPage === totalPages;

              [pageNumbersContainer, pageNumbersContainerTop].forEach(function(container) {
                if (container) {
                  var existingBtns = container.querySelectorAll('.page-number-btn');
                  if (existingBtns.length === totalPages) {
                    existingBtns.forEach(function(btn, idx) {
                      var pageNum = idx + 1;
                      if (pageNum === currentPage) {
                        btn.classList.add('active-page');
                      } else {
                        btn.classList.remove('active-page');
                      }
                    });
                  } else {
                    container.innerHTML = '';
                    for (var i = 1; i <= totalPages; i++) {
                      var btn = document.createElement('button');
                      btn.type = 'button';
                      btn.className = 'page-number-btn' + (i === currentPage ? ' active-page' : '');
                      btn.setAttribute('data-page', i.toString());
                      btn.textContent = i.toString();
                      container.appendChild(btn);
                    }
                  }
                }
              });
            }
          }

          function updateURL() {
            try {
              if (window.location.protocol === 'file:') return;
              var url = new URL(window.location.href);
              if (activeTag) {
                url.searchParams.set('tag', activeTag);
              } else {
                url.searchParams.delete('tag');
              }
              if (activeYear) {
                url.searchParams.set('year', activeYear);
              } else {
                url.searchParams.delete('year');
              }
              if (activeMonth !== null) {
                url.searchParams.set('month', activeMonth.toString());
              } else {
                url.searchParams.delete('month');
              }
              if (currentPage > 1) {
                url.searchParams.set('page', currentPage.toString());
              } else {
                url.searchParams.delete('page');
              }
              window.history.pushState({}, '', url.toString());
            } catch (e) {
              // Ignore history update errors in local file preview environments
            }
          }

          function setFilterState(tag, year, month) {
            activeTag = tag;
            activeYear = year;
            activeMonth = month !== null ? parseInt(month, 10) : null;
            currentPage = 1;
            updateURL();
            updateView();
          }

          function goToPage(page) {
            var matchingCards = getMatchingCards();
            var totalPages = Math.ceil(matchingCards.length / ITEMS_PER_PAGE) || 1;
            if (page >= 1 && page <= totalPages && page !== currentPage) {
              currentPage = page;
              updateURL();
              updateView();
              var scrollTarget = document.querySelector('.blog-list-container');
              if (scrollTarget) {
                var rect = scrollTarget.getBoundingClientRect();
                if (rect.top < -50) {
                  scrollTarget.scrollIntoView({ behavior: 'smooth' });
                }
              }
            }
          }

          function loadFromURL() {
            var params = new URLSearchParams(window.location.search);
            var tagParam = params.get('tag');
            var yearParam = params.get('year');
            var monthParam = params.get('month');
            var pageParam = params.get('page');
            
            activeTag = tagParam ? tagParam.toLowerCase().trim() : null;
            activeYear = yearParam || null;
            activeMonth = monthParam ? parseInt(monthParam, 10) : null;
            currentPage = pageParam ? parseInt(pageParam, 10) : 1;

            updateView();
          }

          window.blogFilter = {
            goToPage: goToPage,
            setFilterState: setFilterState,
            updateView: updateView,
            loadFromURL: loadFromURL
          };

          // Attach Global Event Listeners ONCE
          if (!window.__blogFiltersAttached) {
            window.__blogFiltersAttached = true;

            document.addEventListener('click', function(e) {
              var target = e.target;
              if (!target) return;

              // 1. Page Number button
              var pageBtn = target.closest('.page-number-btn');
              if (pageBtn) {
                e.preventDefault();
                e.stopPropagation();
                var page = parseInt(pageBtn.getAttribute('data-page'), 10);
                if (!isNaN(page)) {
                  goToPage(page);
                }
                return;
              }

              // 2. Previous page buttons
              var prevBtn = target.closest('#prevPageBtn, #prevPageBtnTop');
              if (prevBtn) {
                e.preventDefault();
                e.stopPropagation();
                goToPage(currentPage - 1);
                return;
              }

              // 3. Next page buttons
              var nextBtn = target.closest('#nextPageBtn, #nextPageBtnTop');
              if (nextBtn) {
                e.preventDefault();
                e.stopPropagation();
                goToPage(currentPage + 1);
                return;
              }

              // 4. Tag badges on cards
              var tagBtn = target.closest('.tag-button');
              if (tagBtn) {
                e.preventDefault();
                e.stopPropagation();
                var tag = tagBtn.getAttribute('data-tag');
                var nextTag = (activeTag && tag && activeTag.toLowerCase() === tag.toLowerCase()) ? null : tag;
                setFilterState(nextTag, activeYear, activeMonth !== null ? activeMonth.toString() : null);
                var container = document.querySelector('.blog-list-container');
                if (container) container.scrollIntoView({ behavior: 'smooth' });
                return;
              }

              // 5. Individual clear filter pills
              var pillBtn = target.closest('.pill-clear-btn');
              if (pillBtn) {
                e.preventDefault();
                e.stopPropagation();
                var filterType = pillBtn.getAttribute('data-type');
                if (filterType === 'tag') {
                  setFilterState(null, activeYear, activeMonth !== null ? activeMonth.toString() : null);
                } else if (filterType === 'date') {
                  setFilterState(activeTag, null, null);
                }
                return;
              }

              // 6. Clear all button
              var clearBtn = target.closest('#clearFilterBtn');
              if (clearBtn) {
                e.preventDefault();
                e.stopPropagation();
                setFilterState(null, null, null);
                return;
              }
            });

            // Date select change listeners
            document.addEventListener('change', function(e) {
              if (e.target && e.target.id === 'yearFilter') {
                var yearVal = e.target.value;
                if (yearVal === 'all') {
                  setFilterState(activeTag, null, null);
                } else {
                  setFilterState(activeTag, yearVal, null);
                }
              } else if (e.target && e.target.id === 'monthFilter') {
                var monthVal = e.target.value;
                if (monthVal === 'all') {
                  setFilterState(activeTag, activeYear, null);
                } else {
                  setFilterState(activeTag, activeYear, monthVal);
                }
              }
            });

            window.addEventListener('popstate', loadFromURL);
            document.addEventListener('astro:page-load', loadFromURL);
            document.addEventListener('astro:after-swap', loadFromURL);
          }

          // Initialize view on load
          if (document.readyState === 'interactive' || document.readyState === 'complete') {
            loadFromURL();
          } else {
            document.addEventListener('DOMContentLoaded', loadFromURL);
          }
          loadFromURL();
        })();
      </script>
    </div>
  </div>
</Layout>

<style>
  .blog-index-page {
    padding-bottom: 5rem;
  }

  .page-header {
    background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--border-color);
    text-align: center;
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 1rem auto 0;
  }

  .blog-list-container {
    margin-top: 3rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .blog-list-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    background: rgba(17, 21, 32, 0.4);
    border: 1px solid var(--glass-border);
    align-items: stretch;
    min-height: 140px;
  }

  .card-thumbnail {
    width: 20%;
    min-width: 100px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--glass-border);
    display: flex;
  }

  .card-thumbnail a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition);
  }

  .blog-list-card:hover .thumbnail-img {
    transform: scale(1.05);
  }

  .card-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
  }

  .card-date {
    color: var(--teal-accent);
    font-weight: 500;
  }

  .card-badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .card-badge {
    background: rgba(139, 92, 246, 0.15);
    color: var(--accent-color);
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    border: 1px solid rgba(139, 92, 246, 0.3);
    font-weight: 600;
    font-size: 0.75rem;
    font-family: var(--font-display), sans-serif;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .card-badge:hover {
    background: rgba(139, 92, 246, 0.35);
    border-color: var(--accent-color);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .blog-list-card h2 {
    font-size: 1.45rem;
    margin-bottom: 0.5rem;
  }

  .blog-list-card h2 a {
    color: var(--text-primary);
  }

  .blog-list-card h2 a:hover {
    color: var(--accent-color);
  }

  .card-description {
    color: var(--text-secondary);
    margin-bottom: 0.85rem;
    flex-grow: 1;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .card-footer {
    display: flex;
    align-items: center;
  }

  .read-more {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent-color);
    transition: var(--transition);
  }

  .read-more:hover {
    color: var(--text-primary);
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .blog-list-card {
      padding: 1rem;
      gap: 1.2rem;
    }
    .card-thumbnail {
      width: 20%;
      min-width: 75px;
    }
    .blog-list-card h2 {
      font-size: 1.3rem;
      margin-bottom: 0.5rem;
    }
    .card-description {
      font-size: 0.95rem;
      margin-bottom: 1rem;
    }
  }

  /* Filter Status Header */
  .filter-status {
    background: rgba(17, 21, 32, 0.4);
    border: 1px solid rgba(0, 242, 254, 0.15);
    border-radius: 12px;
    padding: 0.75rem 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin: 0 auto 3rem; /* Centered horizontally with 3rem bottom margin to push cards down */
    max-width: 800px;
    font-family: var(--font-display);
    color: var(--text-primary);
    box-shadow: 0 4px 20px rgba(0, 242, 254, 0.05);
    flex-wrap: wrap;
